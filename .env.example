NODE_ENV=development
PORT=3000
API_PORT=3000
POSTGRES_DB=stack_atlas
POSTGRES_USER=stack_atlas
POSTGRES_PASSWORD=stack_atlas_local
POSTGRES_PORT=5432
LOCAL_UID=1000
LOCAL_GID=1000
DATABASE_TEST_URL=postgresql://stack_atlas:stack_atlas_local@127.0.0.1:5432/stack_atlas_test
# Set only for tests against an approved disposable PostgreSQL test database.
# ALLOW_DESTRUCTIVE_TEST_DATABASE=true
DATABASE_URL=postgresql://stack_atlas:stack_atlas_local@127.0.0.1:5432/stack_atlas
DATABASE_VERIFY_ADMIN_URL=postgresql://stack_atlas:stack_atlas_local@127.0.0.1:5432/postgres
DB_POOL_MAX=10
SESSION_COOKIE_NAME=stack_atlas_session
SESSION_TTL_SECONDS=604800
# Exact browser origins. Web's local Next.js app runs on port 3001.
CORS_ORIGINS=http://localhost:3001
