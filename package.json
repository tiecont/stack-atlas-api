{
  "name": "stack-atlas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Stack Atlas business and control-plane API",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run && npm run test:structure",
    "test:watch": "vitest",
    "test:structure": "node scripts/testing/check-test-placement.mjs",
    "test:db:create": "node scripts/testing/create-test-databases.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:precommit": "npm run typecheck && npm run lint && npm test && npm run build",
    "migrate": "node scripts/migrations/runner.mjs up",
    "migration:data-up": "node scripts/migrations/runner.mjs data-up",
    "migration:create": "node scripts/migrations/create-migration.mjs",
    "migration:up": "npm run migrate",
    "migration:down": "node scripts/migrations/runner.mjs down",
    "migration:preflight": "node scripts/migrations/runner.mjs preflight",
    "migration:preflight:data": "node scripts/migrations/runner.mjs preflight data-up",
    "migration:check-timestamps": "node scripts/migrations/check-timestamps.mjs",
    "migration:verify": "node scripts/migrations/verify.mjs",
    "platform:authorization": "node scripts/identity/platform-authorization-admin.mjs",
    "content:git-import": "node scripts/content/catalog/git-import.mjs",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execFileSync('husky', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.2",
    "node-pg-migrate": "^9.0.0",
    "parse5": "^8.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
