{
  "name": "stack-atlas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Stack Atlas business and control-plane API",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "migration": "node-pg-migrate --migrations-dir database/migrations",
    "migration:create": "node-pg-migrate create --migrations-dir database/migrations --migration-file-language js",
    "migration:up": "node-pg-migrate up --migrations-dir database/migrations",
    "migration:down": "node-pg-migrate down --migrations-dir database/migrations"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.10"
  }
}
